" ---------- General Editing & Search ----------
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set smarttab
set smartindent
set autoindent
set wrap
set linebreak
set whichwrap+=<,>,h,l
set backspace=indent,eol,start
set clipboard=unnamedplus

set hlsearch
set incsearch
set ignorecase
set smartcase

" Persistence
set undofile
set undodir=~/.vim/undo//
set backupdir=~/.vim/backup//
set directory=~/.vim/swap//
set writebackup